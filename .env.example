# Puerto y Entorno
PORT=8000
DEBUG=True

# URL pública (Para que los códigos QR apunten a tu dominio en internet al desplegarlo)
# Ej: https://mi-evento-fotos.onrender.com
PUBLIC_URL=

# Tamaño máximo de fotos y videos permitidos (en Megabytes)
MAX_FILE_SIZE_MB=100

# Clave secreta
SECRET_KEY=cambiar-por-una-clave-secreta-en-produccion

# Almacenamiento en la Nube con Cloudinary (Opcional - por defecto guarda localmente)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
